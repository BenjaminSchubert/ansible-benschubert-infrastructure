{{ template_warning }}
---
http:
  routers:
    mimir:
      rule: Host(`{{ hostname }}`)
      service: mimir
      priority: 10
      middlewares:
        - authentik@file

    mimir-auth:
      rule: Host(`{{ hostname }}`) && PathPrefix(`/outpost.goauthentik.io/`)
      priority: 15
      service: authentik@file

  services:
    mimir:
      loadBalancer:
        servers:
          - url: http://monitoring-mimir:9009
